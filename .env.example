# LinkedIn (get li_at cookie from browser DevTools > Application > Cookies)
# LINKEDIN_COOKIE=your_li_at_cookie_value

# ZeroBounce: primary email verifier (1 credit per address checked)
# ZEROBOUNCE_API_KEY=your_zerobounce_key

# Hunter.io: email finder, verifier fallback (free tier = 25 lookups/month)
# HUNTER_API_KEY=your_hunter_api_key

# Proxy support (optional, pick one)
# SCOUT_PROXY=http://user:pass@host:port
# SCOUT_PROXY_FILE=proxies.txt
# SCOUT_FREE_PROXY=true

# Brave Search API key: web search for enrichment and menu Discover (free tier at brave.com/search/api)
# BRAVE_API_KEY=your_brave_key

# SMTP verification identity (optional; use a domain you control for better acceptance)
# SCOUT_SMTP_HELO=mail.yourdomain.com
# SCOUT_SMTP_FROM=verify@yourdomain.com

# Cache for searches and verifications (7 days); SCOUT_CACHE=0 disables
# SCOUT_CACHE_DIR=.scout_cache
