# Enrichment keys (all optional; each adds a source or verifier)
# BRAVE_API_KEY=your_brave_key          # web search (free tier at brave.com/search/api)
# HUNTER_API_KEY=your_hunter_key        # email finder + verifier when SMTP can't decide

# SMTP verification identity (use a domain you control for better acceptance)
# SCOUT_SMTP_HELO=mail.yourdomain.com
# SCOUT_SMTP_FROM=verify@yourdomain.com

# Optional single egress proxy
# SCOUT_PROXY=http://user:pass@host:port

# Cache for searches and verifications (7 days); SCOUT_CACHE=0 disables
# SCOUT_CACHE_DIR=.scout_cache
